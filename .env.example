# MIRAI Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment

# API Server Configuration
MIRAI_API_HOST=0.0.0.0
MIRAI_API_PORT=8000
MIRAI_API_DEBUG=false
MIRAI_CORS_ORIGINS=*

# Ollama LLM Runtime
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SEC=30.0

# Database & Storage
MIRAI_DB_PATH=data/paper_trading.db
MIRAI_LOG_LEVEL=INFO

# Monitoring & System Thresholds
MONITORING_LATENCY_THRESHOLD_MS=1000.0
MONITORING_STALE_DATA_TIMEOUT_SEC=300.0
MONITORING_ERROR_RATE_THRESHOLD_PCT=5.0
